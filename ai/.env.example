# AI 服务本地开发配置。
# 复制成 .env 再填真实值 —— .env 已被 .gitignore 忽略，不会进版本库。
# 真实密钥不要提交、不要贴进对话；本服务从环境变量读，不落盘。

# ---- 模型供应商（OpenAI 兼容接口）----
# 当前接的是 DeepSeek：**文本 + 图片可用**（图片只有 flash 看得见，pro 看不见），
# 无语音转写、无向量。依据与实测记录见 docs/adr/0017-model-provider-deepseek.md
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
# 分级模型：默认 flash（pro 延迟 5.6~20.3s，实测有超时；见 ADR-0017）
AI_MODEL_GRADING=deepseek-flash
# 视觉模型：留空表示不支持图片（带图请求会被明确降级并告知）
AI_VISION_MODEL=deepseek-flash

# 推理型模型会把输出预算烧在 reasoning 上：给少了返回空 content（finish_reason=length）。
# 40 / 120 / 900 / 1500 都实测踩过；一次带图的真实分级用了 1083 个输出 token，所以按 3000 起。
AI_MAX_OUTPUT_TOKENS=3000
AI_MAX_IMAGES=4
AI_TIMEOUT_SECONDS=20
AI_MAX_REPAIR_RETRY=1

# 能力开关。换成有这些能力的供应商时改这里（并更新 ADR-0017）：
# 调用方按这些开关决定走不走降级，别靠「模型名填没填」来判断。
AI_SUPPORTS_IMAGE=true
AI_SUPPORTS_AUDIO=false
AI_SUPPORTS_EMBEDDING=false

# 提示词版本（提示词入 DB 前手工维护，随每次调用落库用于归因分级漂移）
PROMPT_VERSION=p0-code

# ---- 知识检索与运营可调项（切片 #100 / #103）----
# 三个缓存都是同一取舍：运营在后台改完，最多滞后这么久生效；调小 = 更及时但每次咨询多两三次小查询。
OPS_CACHE_SECONDS=60
KNOWLEDGE_CACHE_SECONDS=60
# 进模型上下文的条目数上限 / 每次取回的候选数 / 检索词上限 / 单条正文截断字数。
# 这几个是**技术参数**（改错的代价是回答质量，不是业务口径），所以在这里而不是库里。
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MAX_CANDIDATES=20
KNOWLEDGE_MAX_TERMS=12
KNOWLEDGE_BODY_CHARS=400
KNOWLEDGE_L1_TOP_K=3
# 知识域查询的读超时：它在咨询的请求路径上，读不到就该尽快降级
MYSQL_READ_TIMEOUT_SECONDS=3

# ---- 基础设施（本服务对知识域只读，ADR-0009）----
MYSQL_HOST=127.0.0.1
# 3307 不是 3306：本机原生 Windows MySQL 占着 3306
MYSQL_PORT=3307
MYSQL_DATABASE=pet_health
MYSQL_USER=root
MYSQL_PASSWORD=devroot

# ---- 内部鉴权：必须与后端 AI_SERVICE_TOKEN 一致 ----
INTERNAL_TOKEN=dev-internal-token
