<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.pethealth</groupId>
    <artifactId>pet-health-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ph-provider</artifactId>
  <name>ph-provider</name>
  <description>服务者 / 入驻审核 / 资质 / 门店 / 选品定价上架</description>

  <dependencies>
    <dependency>
      <groupId>com.pethealth</groupId>
      <artifactId>ph-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.pethealth</groupId>
      <artifactId>ph-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      依赖 ph-catalog 的理由只有一个：价格区间校验必须复用目录侧的公共服务（ADR-0034）。
      方向是单向的 provider → catalog，反过来 catalog 不需要服务者数据，所以不会成环（ADR-0006）。
    -->
    <dependency>
      <groupId>com.pethealth</groupId>
      <artifactId>ph-catalog</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      依赖 ph-order 的理由也只有一个：考核（F022）的过程分要那几个数——按状态的单量、
      服务者单方取消数、接单响应均值——它们由订单侧的只读接口 OrderStatsApi 提供
      （`com.pethealth.order.api`，口径写在那个接口的类注释里）。
      **不 join 订单表**（ADR-0006）：这里只依赖接口，订单的表与状态机仍归 ph-order。
      方向同样单向：ph-order 不依赖 ph-provider（它按需经 ph-api 的接口取服务者数据），不会成环。
    -->
    <dependency>
      <groupId>com.pethealth</groupId>
      <artifactId>ph-order</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      依赖 ph-file 的理由：资质材料的图片读地址要由后端当场签发（ADR-0053），
      取元数据的口子是 `com.pethealth.file.api.FileQueryApi`（按 id 取、不按上传者过滤，
      调用方负责自己的归属校验——审核员不是上传者，用按归属过滤的 FileUrlApi 会拿到空地址）。
      这条依赖原先只是经 ph-order **传递**进来（ph-order 依赖 ph-file），这里是把隐性依赖写明：
      本模块现在直接 import 它的 api 包，不写清楚的话，哪天 ph-order 去掉了 ph-file，
      编译才会在很远的地方报错。方向单向：ph-file 不依赖任何业务模块（ADR-0006），不会成环。
    -->
    <dependency>
      <groupId>com.pethealth</groupId>
      <artifactId>ph-file</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
</project>
