# AI 服务本地开发配置。
# 复制成 .env 再填真实值 —— .env 已被 .gitignore 忽略，不会进版本库。
# 真实密钥不要提交、不要贴进对话；本服务从环境变量读，不落盘。

# ---- 模型（阿里云百炼）----
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL_CHAT=qwen3-vl-plus
AI_MODEL_FAST=qwen3-vl-flash
AI_MODEL_ASR=paraformer-v2
AI_MODEL_EMBED=qwen3.7-text-embedding
AI_MAX_REPAIR_RETRY=1

# ---- 基础设施（本服务对知识域只读）----
MYSQL_HOST=127.0.0.1
# 3307 不是 3306：本机原生 Windows MySQL 占着 3306
MYSQL_PORT=3307
MYSQL_DATABASE=pet_health
MYSQL_USER=root
MYSQL_PASSWORD=devroot
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- 内部鉴权：必须与后端 AI_SERVICE_TOKEN 一致 ----
INTERNAL_TOKEN=dev-internal-token
