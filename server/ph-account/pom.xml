<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.pethealth</groupId>
    <artifactId>pet-health-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ph-account</artifactId>
  <name>ph-account</name>
  <description>账号 / 登录 / 会话 / RBAC / 数据域 / 审计</description>

  <dependencies>
    <dependency>
      <groupId>com.pethealth</groupId>
      <artifactId>ph-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.pethealth</groupId>
      <artifactId>ph-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 切换当前宠物要校验「这只宠物是不是他的」——走 record 模块暴露的接口，不直连它的表（ADR-0006） -->
    <dependency>
      <groupId>com.pethealth</groupId>
      <artifactId>ph-reminder</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.pethealth</groupId>
      <artifactId>ph-record</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      注册归因（`POST /api/v1/app/invites/attribution`，契约见 app.yaml）走 ph-privilege 的
      `InviteAttributionApi`：邀请关系是那张模块的表，ADR-0006 不许本模块碰。
      方向是单向的 ph-account → ph-privilege（ph-privilege 只依赖 ph-catalog），不会成环；
      与上面那条 ph-record 同一个理由——「注册那一刻」发生在本模块，所以由本模块把调用发出去，
      而不是让 ph-privilege 反过来知道注册流程长什么样。
    -->
    <dependency>
      <groupId>com.pethealth</groupId>
      <artifactId>ph-privilege</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Refresh Token 存 Redis，可吊销（ADR-0012） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!-- 指标 API（MeterRegistry / Counter）。actuator 只在 ph-boot 里，所以这个模块要显式声明；
         版本由 Spring Boot 的依赖管理给，与 ph-boot 里的 actuator 天然同版 -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>

    <!-- 只取 bcrypt，不要 spring-boot-starter-security：鉴权由自己的过滤器做，
         角色 × 资源的 RBAC 随 #60 落地，届时再决定要不要引入安全框架 -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
