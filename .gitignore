server/ph-boot/data/
server/data/

# ---- 本地环境 ----
.env
.env.local
*.env.local
deploy/data/

# ---- 本机工具的忽略文件（不属于仓库）----
.zcodeignore

# ---- 测试产物（GUI 实测截图，不入库；归档在 docs/testing/screenshots-<日期>/）----
docs/testing/screenshots-*/

# ---- 系统 ----
.DS_Store
Thumbs.db
