<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.pethealth</groupId>
    <artifactId>pet-health-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ph-ai</artifactId>
  <name>ph-ai</name>
  <description>AI 服务的客户端：调用 / 配额 / 熔断 / 留痕（提示词编排与风险分级在 ai/ 服务里，ADR-0009）</description>

  <dependencies>
    <dependency>
      <groupId>com.pethealth</groupId>
      <artifactId>ph-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.pethealth</groupId>
      <artifactId>ph-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 图片参与判断：AI 服务要用图，而图是私有的，读地址由文件模块签发（ADR-0020/0021） -->
    <dependency>
      <groupId>com.pethealth</groupId>
      <artifactId>ph-file</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 分级要看品种/年龄/慢病：拿宠物快照，但仍不碰 pet 表（ADR-0006 的接口调用） -->
    <dependency>
      <groupId>com.pethealth</groupId>
      <artifactId>ph-record</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- 本模块的单元测试：只有纯函数（例如日预算的估算算术），不启 Spring 容器 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
