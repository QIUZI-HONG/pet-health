# 后端本地开发配置。
# 复制成 server/.env 再填真实值——.env 已被 .gitignore 忽略，不会进版本库。
#
# 用法：在 server/ 目录下起后端时自动读取（application.yml 里的 spring.config.import）；
# CI 与生产不用这个文件，直接把同名环境变量传给进程。
#
# 这三个都必须配，否则应用**启动即失败**（故意如此：仓库里不放默认密钥，
# 免得「部署时忘了配」一直没人发现）。

# ---- 会话签名（ADR-0012）----
# 至少 32 字节，否则 jjwt 拒绝签名
JWT_SECRET=
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d
LOGIN_MAX_FAILURES=10
LOGIN_LOCK_WINDOW=15m

# ---- 敏感字段加密（ADR-0013）----
# 各 32 字节、base64 编码，两把必须不同：enc 管密文，hmac 管等值查找与唯一索引
FIELD_ENC_KEY=
FIELD_HMAC_KEY=
# 只在密钥轮换期间填
FIELD_ENC_KEY_PREVIOUS=

# ---- 数据库 / Redis（默认值与 deploy/docker-compose.dev.yml 一致，本地可不改）----
MYSQL_URL=jdbc:mysql://127.0.0.1:3307/pet_health?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=Asia/Shanghai
MYSQL_USER=root
MYSQL_PASSWORD=devroot
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ---- 考核规则与单项分覆盖的白名单（ADR-0052）----
# 账号 id 列表，逗号分隔。**不配 = 这两个动作没人能做**（fail-closed，不是「谁都能做」）。
# 目前只为超级管理员判定服务；角色体系落地后名单机制删掉。
ASSESSMENT_SUPER_ADMIN_USER_IDS=

# ---- 运营后台的登录准入（ADR-0035「需要协调」第 3 条）----
# 能进运营后台的账号 id 列表，逗号分隔。**不配 = 谁都进不去**（fail-closed）：运营后台看得到
# 全平台数据，默认开放等于把门禁的钥匙挂在门上。服务者后台**不看这个名单**——它的准入是
# 「任何启用中的账号都能登」（BPM-4 要先能提交入驻申请，理由见 ConsoleAuthService）。
CONSOLE_ADMIN_USER_IDS=

# 生成三把密钥（在 server/ 目录下执行）：
#   echo "JWT_SECRET=$(openssl rand -base64 48)"      >> .env
#   echo "FIELD_ENC_KEY=$(openssl rand -base64 32)"   >> .env
#   echo "FIELD_HMAC_KEY=$(openssl rand -base64 32)"  >> .env
